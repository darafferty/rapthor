# Manual version of the parset assembled by test_rapthor_run_multi_cycles.
# This file is intended to be run in the development container, where the
# repository is mounted at /app. CWL inputs need absolute paths because relative
# paths are resolved from the generated workflow directory, not the shell's cwd.
# The integration fixture replaces input_ms with its synthesized source-filled
# copy of test.ms; manual runs use the unmodified resource MS named below.

[global]
dir_working = /tmp/rapthor-multi-cycle-profile-12
input_ms = /app/tests/resources/test_integration.ms
data_colname = DATA
generate_initial_skymodel = False
generate_initial_skymodel_radius = None
generate_initial_skymodel_data_fraction = 0.2
download_initial_skymodel = False
download_initial_skymodel_radius = 5.0
download_initial_skymodel_server = TGSS
download_overwrite_skymodel = True
input_skymodel = /app/tests/resources/integration_true_sky.txt
apparent_skymodel = /app/tests/resources/integration_apparent_sky.txt
regroup_input_skymodel = True
strategy = /app/tests/resources/manual_testing_strategy.py
selfcal_data_fraction = 1.0
input_h5parm = None
input_fulljones_h5parm = None
facet_layout = None
dde_mode = faceting


[calibration]
fast_freqstep_hz = 1e6
slow_freqstep_hz = 1e6
fast_smoothnessconstraint = 6.0e6
slow_smoothnessconstraint = 4.0e6
propagatesolutions = True
use_wsclean_predict = False
wsclean_predict_bw = 2e6
maxiter = 50
stepsize = 0.2
tolerance = 0.001
bda_timebase = 0.0
bda_frequencybase = 0.0

[imaging]
use_mpi = False
grid_width_ra_deg = 0.25
grid_width_dec_deg = 0.25
grid_center_ra = 1h37m41.299s
grid_center_dec = +33d09m35.132s
grid_nsectors_ra = 1
idg_mode = cpu
reweight = False
average_visibilities = False
photometry_skymodel = /app/tests/resources/integration_true_sky.txt
astrometry_skymodel = /app/tests/resources/integration_true_sky.txt
shared_facet_rw = False
normalization_skymodels =
normalization_reference_frequencies = None
dde_method = full
bda_timebase = 0.0
bda_frequencybase = 0.0
do_multiscale_clean = False

[cluster]
batch_system = single_machine
max_nodes = 1
cpus_per_task = 0
mem_per_node_gb = 0
fail_on_calibration_oom_risk = False
max_cores = 0
max_threads = 0
deconvolution_threads = 0
parallel_gridding_tasks = 0
local_scratch_dir = /tmp
global_scratch_dir = /tmp
use_container = False
container_type = docker
cwl_runner = toil
debug_workflow = False
keep_temporary_files = False
allow_internet_access = False
