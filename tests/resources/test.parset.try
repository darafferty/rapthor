[global]
strategy = /home/rafferty/full_field_strategy.py
dir_working = .
input_ms = resources/test.ms
data_colname = DATA
input_skymodel = resources/test_true_sky.txt
apparent_skymodel = resources/test_apparent_sky.txt
regroup_input_skymodel = True
selfcal_data_fraction = 0.2

[calibration]
fast_freqstep_hz = 1e6
slow_freqstep_hz = 1e6
fast_smoothnessconstraint = 6.0e6
slow_smoothnessconstraint = 4.0e6
propagatesolutions = True
maxiter = 50
maxapproxiter = 25
stepsize = 0.2
tolerance = 0.001

[imaging]
sector_center_ra_list = [17h05m22s, 17h25m22s]
sector_center_dec_list = [+57d14m39s, +57d34m39s]
sector_width_ra_deg_list = [0.333, 0.250]
sector_width_dec_deg_list = [0.333, 0.250]
idg_mode = cpu
reweight = True
use_mpi = True
photometry_skymodel = None
astrometry_skymodel = None

[cluster]
cpus_per_task = 4
max_nodes = 4
batch_system = slurm
max_threads = 40
deconvolution_threads = 4
